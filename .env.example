# ─── Flow — Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# The EXPO_PUBLIC_ prefix makes variables available at runtime in Expo
# managed workflow without any additional build config.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Future: EAS Build secrets (do NOT use EXPO_PUBLIC_ prefix for secrets) ──
# These are set in EAS dashboard, not here. Listed for reference only.
# EAS_APPLE_TEAM_ID=
# EAS_GOOGLE_SERVICES_JSON=
